{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "{{REPO}}/instructions/opencode-development.md"
  ],
  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      "sudo *": "ask",
      "doas *": "ask",
      "su *": "ask",
      "rm *": "ask",
      "rmdir *": "ask",
      "shred *": "ask",
      "dd *": "ask",
      "mkfs*": "ask",
      "fdisk *": "ask",
      "parted *": "ask",
      "mount *": "ask",
      "umount *": "ask",
      "chown *": "ask",
      "chmod -R *": "ask",
      "git commit*": "ask",
      "git push*": "ask",
      "git pull*": "ask",
      "git reset*": "ask",
      "git clean*": "ask",
      "git restore*": "ask",
      "git checkout -- *": "ask",
      "git checkout -f*": "ask",
      "git switch --discard-changes*": "ask",
      "git rebase*": "ask",
      "git merge*": "ask",
      "git cherry-pick*": "ask",
      "git branch -D *": "ask",
      "git stash drop*": "ask",
      "git stash clear*": "ask",
      "gh pr create*": "ask",
      "gh pr edit*": "ask",
      "gh pr merge*": "ask",
      "gh pr close*": "ask",
      "gh issue create*": "ask",
      "gh issue edit*": "ask",
      "gh issue close*": "ask",
      "gh release create*": "ask",
      "gh release edit*": "ask",
      "gh release delete*": "ask",
      "gh release upload*": "ask",
      "gh repo create*": "ask",
      "gh repo delete*": "ask",
      "gh repo archive*": "ask",
      "gh repo rename*": "ask",
      "npm publish*": "ask",
      "npm unpublish*": "ask",
      "pnpm publish*": "ask",
      "yarn npm publish*": "ask",
      "cargo publish*": "ask",
      "twine upload*": "ask",
      "gem push*": "ask",
      "docker push*": "ask",
      "docker system prune*": "ask",
      "docker volume prune*": "ask",
      "ssh *": "ask",
      "scp *": "ask",
      "aws *": "ask",
      "az *": "ask",
      "gcloud *": "ask",
      "kubectl *": "ask",
      "terraform apply*": "ask",
      "terraform destroy*": "ask"
    },
    "edit": {
      "*": "allow",
      "{{HOME}}/.agents/skills/**": "deny",
      "{{HOME}}/.claude/skills/**": "deny"
    },
    "external_directory": {
      "*": "ask",
      "~/**": "allow",
      "/tmp/**": "allow"
    },
    "doom_loop": "ask"
  }
}
